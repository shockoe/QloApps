meta {
  name: Customer Signup
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/external/customer-signup
  body: json
  auth: inherit
}

body:json {
  {
    "email": "testuser@shockoe.com",
    "passwd": "Password123!",
    "firstname": "Test",
    "lastname": "User",
    "birthday": "1990-01-01",
    "newsletter": true,
    "optin": true,
    "id_gender": 1
  }
}

script:post-response {
  if (res.status === 200 && res.body.success) {
    bru.setEnvVar('CUSTOMER_EMAIL', res.body.email);
    bru.setEnvVar('CUSTOMER_ID', res.body.customer_id);
    console.log('Customer created successfully:', res.body.email);
  } else {
    console.error('Customer signup failed:', res.body.error || res.body);
  }
}
